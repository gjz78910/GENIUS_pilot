#!/usr/bin/env bash
set -euo pipefail

PARTICIPANT_ID="{{ participantId }}"
SESSION_ID="{{ sessionId }}"
ARTIFACT_BUCKET="${artifact_bucket}"
PROJECT_DIR="/home/participant/GENIUS_pilot"
RUNTIME_DIR="/home/participant/genius-runtime"
ARCHIVE="/tmp/genius-$PARTICIPANT_ID-$SESSION_ID-$(date -u +%Y%m%dT%H%M%SZ).tar.gz"

systemctl stop genius-monitor.service || true
/usr/local/bin/genius-collection-health snapshot || true

sudo -u participant -H bash -lc "
  /usr/local/bin/genius-screen-recorder stop || true
"

if [ ! -d "$PROJECT_DIR" ]; then
  echo "Project directory not found: $PROJECT_DIR" >&2
  exit 1
fi

chown -R participant:participant "$PROJECT_DIR"

sudo -u participant -H bash -lc "
  set -e
  cd '$PROJECT_DIR'
  ./SCRIPTS/submit_participant_work.sh '$PARTICIPANT_ID' '$SESSION_ID' || true
"

systemctl stop genius-resource-monitor.service || true

sudo -u participant -H bash -lc "
  set -e
  cd '$PROJECT_DIR'
  mkdir -p DATA_COLLECTION
  cp -a '$RUNTIME_DIR'/. DATA_COLLECTION/ 2>/dev/null || true
  cp -a '$RUNTIME_DIR'/screen_recording_segments.json DATA_COLLECTION/ 2>/dev/null || true
  mkdir -p DATA_COLLECTION/screen_recordings
  if [ -f /home/participant/Videos/GENIUS_'$PARTICIPANT_ID'_'$SESSION_ID'.mp4 ]; then
    cp -a /home/participant/Videos/GENIUS_'$PARTICIPANT_ID'_'$SESSION_ID'.mp4 DATA_COLLECTION/screen_recordings/
  fi
  for recording in /home/participant/Videos/GENIUS_'$PARTICIPANT_ID'_'$SESSION_ID'_merged.mp4 \
    /home/participant/Videos/GENIUS_'$PARTICIPANT_ID'_'$SESSION_ID'_*.mp4; do
    if [ -f \"\$recording\" ]; then
      cp -a \"\$recording\" DATA_COLLECTION/screen_recordings/
    fi
  done
  mkdir -p DATA_COLLECTION/claude_code_history
  for claude_source in \
    /home/participant/.claude/projects \
    /home/participant/.claude/todos \
    /home/participant/.config/Code/logs; do
    if [ -e \"\$claude_source\" ]; then
      cp -a \"\$claude_source\" DATA_COLLECTION/claude_code_history/
    fi
  done
  {
    echo \"participant_id=$PARTICIPANT_ID\"
    echo \"session_id=$SESSION_ID\"
    echo \"collected_at=$(date -u +%Y-%m-%dT%H:%M:%SZ)\"
    find DATA_COLLECTION/claude_code_history -type f | sed 's#^DATA_COLLECTION/claude_code_history/##' | sort
  } > DATA_COLLECTION/claude_code_history/manifest.txt
"

if [ -f "$PROJECT_DIR/SCRIPTS/collect_claude_code_metrics.py" ]; then
  sudo -u participant -H bash -lc "
    cd '$PROJECT_DIR'
    /opt/conda/bin/conda run -n genius_pilot python SCRIPTS/collect_claude_code_metrics.py --participant-id '$PARTICIPANT_ID' --session-id '$SESSION_ID' || true
  "
else
  CONDITION="$(cat /etc/genius/condition 2>/dev/null || true)"
  if [ "$CONDITION" = "ai" ]; then
    echo "Missing Claude Code metrics collector for AI participant: $PROJECT_DIR/SCRIPTS/collect_claude_code_metrics.py" >&2
    sudo -u participant -H bash -lc "
      cd '$PROJECT_DIR'
      mkdir -p DATA_COLLECTION
      cat > DATA_COLLECTION/claude_code_metrics_'$PARTICIPANT_ID'_'$SESSION_ID'.json <<JSON
{
  \"collection_timestamp\": \"$(date -u +%Y-%m-%dT%H:%M:%SZ)\",
  \"collection_method\": \"missing_collector\",
  \"error\": \"SCRIPTS/collect_claude_code_metrics.py was not present on the participant VM\",
  \"data\": {
    \"total_detected_events\": 0,
    \"claude_conversations\": 0,
    \"claude_user_turns\": 0,
    \"claude_assistant_turns\": 0,
    \"claude_tool_uses\": 0
  }
}
JSON
    "
  fi
fi

if [ -f "$PROJECT_DIR/SCRIPTS/collect_bedrock_token_usage.py" ]; then
  sudo -u participant -H bash -lc "
    cd '$PROJECT_DIR'
    /opt/conda/bin/conda run -n genius_pilot python SCRIPTS/collect_bedrock_token_usage.py --participant-id '$PARTICIPANT_ID' --session-id '$SESSION_ID' --instance-id self --region '$AWS_REGION' || true
  "
else
  CONDITION="$(cat /etc/genius/condition 2>/dev/null || true)"
  if [ "$CONDITION" = "ai" ]; then
    echo "Missing Bedrock token usage collector for AI participant: $PROJECT_DIR/SCRIPTS/collect_bedrock_token_usage.py" >&2
  fi
fi

sudo -u participant -H bash -lc "
  cd '$PROJECT_DIR'
  /opt/conda/bin/conda run -n genius_pilot python SCRIPTS/git_activity_logger.py --participant-id '$PARTICIPANT_ID' || true
  /opt/conda/bin/conda run -n genius_pilot python SCRIPTS/extract_cicd_metrics.py --participant-id '$PARTICIPANT_ID' || true
  /opt/conda/bin/conda run -n genius_pilot python SCRIPTS/collect_test_metrics.py --participant-id '$PARTICIPANT_ID' --session-id '$SESSION_ID' || true
  /opt/conda/bin/conda run -n genius_pilot python SCRIPTS/analyze_code_quality.py --participant-id '$PARTICIPANT_ID' || true
  /opt/conda/bin/conda run -n genius_pilot python SCRIPTS/estimate_energy.py DATA_COLLECTION/resource_usage_'$PARTICIPANT_ID'_'$SESSION_ID'.jsonl --system-info DATA_COLLECTION/system_info_'$PARTICIPANT_ID'.json --participant-id '$PARTICIPANT_ID' || true
  /opt/conda/bin/conda run -n genius_pilot python SCRIPTS/calculate_carbon_footprint.py DATA_COLLECTION/energy_estimate_'$PARTICIPANT_ID'.json --location UK --participant-id '$PARTICIPANT_ID' || true
  /opt/conda/bin/conda run -n genius_pilot python SCRIPTS/aggregate_experiment_data.py '$PARTICIPANT_ID' --session-id '$SESSION_ID' || true
"

tar -czf "$ARCHIVE" \
  -C /home/participant \
  GENIUS_pilot/DATA_COLLECTION \
  GENIUS_pilot/.git \
  GENIUS_pilot/src \
  GENIUS_pilot/tests \
  GENIUS_pilot/data \
  GENIUS_pilot/README.md \
  GENIUS_pilot/requirements.txt \
  GENIUS_pilot/environment.yml

aws s3 cp "$ARCHIVE" "s3://$ARTIFACT_BUCKET/$PARTICIPANT_ID/$SESSION_ID/"
echo "Uploaded $ARCHIVE to s3://$ARTIFACT_BUCKET/$PARTICIPANT_ID/$SESSION_ID/"
