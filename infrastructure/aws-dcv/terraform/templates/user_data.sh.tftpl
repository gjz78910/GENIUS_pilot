#!/usr/bin/env bash
set -euo pipefail

PARTICIPANT_ID="${participant_id}"
SESSION_ID="${session_id}"
CONDITION="${condition}"
PARTICIPANT_PASSWORD="${participant_password}"
ARTIFACT_BUCKET="${artifact_bucket}"
REPO_URL="${repo_url}"
REPO_REF="${repo_ref}"
MONITOR_INTERVAL="${monitor_interval_seconds}"
CLAUDE_CODE_BEDROCK_REGION="${claude_code_bedrock_region}"
CLAUDE_CODE_MODEL="${claude_code_model}"
CLAUDE_CODE_SMALL_FAST_MODEL="${claude_code_small_fast_model}"
AUTO_STOP_MINUTES="${auto_stop_minutes}"
TRUSTED_DCV_CERT_ENABLED="${trusted_dcv_cert_enabled}"
DYNAMIC_DNS_PROVIDER="${dynamic_dns_provider}"
DUCKDNS_TOKEN="${duckdns_token}"
DUCKDNS_DOMAIN="${duckdns_domain}"
DCV_HOSTNAME="${dcv_hostname}"
EXPECTED_PUBLIC_IP="${expected_public_ip}"
LETSENCRYPT_EMAIL="${letsencrypt_email}"
PROJECT_DIR="/home/participant/GENIUS_pilot"
RUNTIME_DIR="/home/participant/genius-runtime"

echo "participant:$PARTICIPANT_PASSWORD" | chpasswd
usermod -aG audio,video participant

# Unattended upgrades can restart DCV during the login window and leave the
# web client with a stale auth socket. Experiment VMs are short-lived, so keep
# package changes under this bootstrap script's control.
systemctl disable --now apt-daily.timer apt-daily-upgrade.timer unattended-upgrades.service 2>/dev/null || true
systemctl stop apt-daily.service apt-daily-upgrade.service unattended-upgrades.service 2>/dev/null || true

# Install a non-snap browser and register it as default.
# Snap Firefox cannot access DCV Xauthority paths under AppArmor.
install -d -m 0755 /etc/apt/keyrings
if [ ! -f /etc/apt/keyrings/google-chrome.gpg ]; then
  curl -fsSL https://dl.google.com/linux/linux_signing_key.pub | gpg --dearmor -o /etc/apt/keyrings/google-chrome.gpg
  chmod 0644 /etc/apt/keyrings/google-chrome.gpg
fi
cat >/etc/apt/sources.list.d/google-chrome.list <<EOF
deb [arch=amd64 signed-by=/etc/apt/keyrings/google-chrome.gpg] https://dl.google.com/linux/chrome/deb/ stable main
EOF
if ! command -v google-chrome-stable >/dev/null 2>&1; then
  apt-get update -qq
  DEBIAN_FRONTEND=noninteractive apt-get install -y google-chrome-stable
fi
update-alternatives --install /usr/bin/x-www-browser x-www-browser /usr/bin/google-chrome-stable 300
update-alternatives --install /usr/bin/gnome-www-browser gnome-www-browser /usr/bin/google-chrome-stable 300
update-alternatives --set x-www-browser /usr/bin/google-chrome-stable
update-alternatives --set gnome-www-browser /usr/bin/google-chrome-stable

if ! command -v kazam >/dev/null 2>&1; then
  apt-get update -qq
  DEBIAN_FRONTEND=noninteractive apt-get install -y kazam
fi

if ! command -v ffmpeg >/dev/null 2>&1 || ! command -v xdpyinfo >/dev/null 2>&1 || ! command -v xterm >/dev/null 2>&1 || ! command -v wmctrl >/dev/null 2>&1; then
  apt-get update -qq
  DEBIAN_FRONTEND=noninteractive apt-get install -y ffmpeg x11-utils xterm wmctrl
fi

if ! command -v node >/dev/null 2>&1 || ! command -v npm >/dev/null 2>&1; then
  apt-get update -qq
  DEBIAN_FRONTEND=noninteractive apt-get install -y nodejs npm
fi

install -d -m 0755 /etc/polkit-1/rules.d
cat >/etc/polkit-1/rules.d/49-genius-color.rules <<'EOF'
polkit.addRule(function(action, subject) {
  if ((action.id == "org.freedesktop.color-manager.create-device" ||
       action.id == "org.freedesktop.color-manager.create-profile" ||
       action.id == "org.freedesktop.color-manager.delete-device" ||
       action.id == "org.freedesktop.color-manager.delete-profile" ||
       action.id == "org.freedesktop.color-manager.modify-device" ||
       action.id == "org.freedesktop.color-manager.modify-profile") &&
      subject.user == "participant") {
    return polkit.Result.YES;
  }
});
EOF
systemctl restart polkit || true

configure_trusted_dcv_certificate() {
  if [ "$TRUSTED_DCV_CERT_ENABLED" != "true" ]; then
    return
  fi

  if [ "$DYNAMIC_DNS_PROVIDER" != "duckdns" ] && [ "$DYNAMIC_DNS_PROVIDER" != "sslip" ]; then
    echo "Unsupported DNS provider: $DYNAMIC_DNS_PROVIDER" >&2
    exit 1
  fi

  if [ -z "$DCV_HOSTNAME" ] || [ -z "$LETSENCRYPT_EMAIL" ]; then
    echo "Trusted DCV certificate setup requires hostname and Let's Encrypt email." >&2
    exit 1
  fi

  if [ "$DYNAMIC_DNS_PROVIDER" = "duckdns" ] && { [ -z "$DUCKDNS_TOKEN" ] || [ -z "$DUCKDNS_DOMAIN" ]; }; then
    echo "DuckDNS setup requires DuckDNS token and domain." >&2
    exit 1
  fi

  if [ "$DYNAMIC_DNS_PROVIDER" = "sslip" ] && [ -z "$EXPECTED_PUBLIC_IP" ]; then
    echo "sslip setup requires expected Elastic IP." >&2
    exit 1
  fi

  if ! command -v certbot >/dev/null 2>&1; then
    apt-get update -qq
    DEBIAN_FRONTEND=noninteractive apt-get install -y certbot
  fi

  METADATA_TOKEN="$(curl -fsS -X PUT http://169.254.169.254/latest/api/token -H "X-aws-ec2-metadata-token-ttl-seconds: 21600")"

  for attempt in $(seq 1 60); do
    PUBLIC_IP="$(curl -fsS -H "X-aws-ec2-metadata-token: $METADATA_TOKEN" http://169.254.169.254/latest/meta-data/public-ipv4)"
    if [ "$DYNAMIC_DNS_PROVIDER" != "sslip" ] || [ "$PUBLIC_IP" = "$EXPECTED_PUBLIC_IP" ]; then
      break
    fi
    sleep 10
  done

  if [ "$DYNAMIC_DNS_PROVIDER" = "sslip" ] && [ "$PUBLIC_IP" != "$EXPECTED_PUBLIC_IP" ]; then
    echo "Instance public IP is '$PUBLIC_IP', expected Elastic IP '$EXPECTED_PUBLIC_IP'." >&2
    exit 1
  fi

  if [ "$DYNAMIC_DNS_PROVIDER" = "duckdns" ]; then
    DUCKDNS_RESPONSE="$(curl -sS -w "\n%%{http_code}" "https://www.duckdns.org/update?domains=$DUCKDNS_DOMAIN&token=$DUCKDNS_TOKEN&ip=$PUBLIC_IP" || true)"
    DUCKDNS_STATUS="$(printf "%s" "$DUCKDNS_RESPONSE" | tail -n 1)"
    DUCKDNS_RESULT="$(printf "%s" "$DUCKDNS_RESPONSE" | sed '$d')"
    if [ "$DUCKDNS_STATUS" != "200" ] || [ "$DUCKDNS_RESULT" != "OK" ]; then
      RESOLVED_IP="$(getent ahostsv4 "$DCV_HOSTNAME" | awk '{print $1; exit}' || true)"
      if [ "$RESOLVED_IP" != "$PUBLIC_IP" ]; then
        echo "DuckDNS update failed for $DUCKDNS_DOMAIN with HTTP $DUCKDNS_STATUS and hostname still resolves to '$RESOLVED_IP'." >&2
        exit 1
      fi
      echo "DuckDNS update returned HTTP $DUCKDNS_STATUS, but $DCV_HOSTNAME already resolves to $PUBLIC_IP; continuing."
    fi
  fi

  for attempt in $(seq 1 30); do
    RESOLVED_IP="$(getent ahostsv4 "$DCV_HOSTNAME" | awk '{print $1; exit}' || true)"
    if [ "$RESOLVED_IP" = "$PUBLIC_IP" ]; then
      break
    fi
    sleep 10
  done

  RESOLVED_IP="$(getent ahostsv4 "$DCV_HOSTNAME" | awk '{print $1; exit}' || true)"
  if [ "$RESOLVED_IP" != "$PUBLIC_IP" ]; then
    echo "$DCV_HOSTNAME resolves to '$RESOLVED_IP', expected '$PUBLIC_IP'." >&2
    exit 1
  fi

  systemctl stop dcvserver 2>/dev/null || true
  certbot certonly \
    --standalone \
    --non-interactive \
    --agree-tos \
    --email "$LETSENCRYPT_EMAIL" \
    --preferred-challenges http \
    --keep-until-expiring \
    -d "$DCV_HOSTNAME"

  DCV_CERT_OWNER="root"
  if id -u dcv >/dev/null 2>&1; then
    DCV_CERT_OWNER="dcv"
  fi
  install -m 0600 -o "$DCV_CERT_OWNER" -g "$DCV_CERT_OWNER" "/etc/letsencrypt/live/$DCV_HOSTNAME/fullchain.pem" /etc/dcv/dcv.pem
  install -m 0600 -o "$DCV_CERT_OWNER" -g "$DCV_CERT_OWNER" "/etc/letsencrypt/live/$DCV_HOSTNAME/privkey.pem" /etc/dcv/dcv.key

  install -d -m 0755 /etc/letsencrypt/renewal-hooks/deploy
  cat >/etc/letsencrypt/renewal-hooks/deploy/reload-dcv.sh <<EOF
#!/usr/bin/env bash
set -euo pipefail
DCV_CERT_OWNER="root"
if id -u dcv >/dev/null 2>&1; then
  DCV_CERT_OWNER="dcv"
fi
install -m 0600 -o "\$DCV_CERT_OWNER" -g "\$DCV_CERT_OWNER" "/etc/letsencrypt/live/$DCV_HOSTNAME/fullchain.pem" /etc/dcv/dcv.pem
install -m 0600 -o "\$DCV_CERT_OWNER" -g "\$DCV_CERT_OWNER" "/etc/letsencrypt/live/$DCV_HOSTNAME/privkey.pem" /etc/dcv/dcv.key
systemctl restart dcvserver || true
systemctl restart genius-dcv-session.service || true
EOF
  chmod 0755 /etc/letsencrypt/renewal-hooks/deploy/reload-dcv.sh
}

install -d -m 0755 /etc/genius
printf "%s\n" "$CONDITION" >/etc/genius/condition
cat >/etc/genius/session.env <<EOF
PARTICIPANT_ID=$PARTICIPANT_ID
SESSION_ID=$SESSION_ID
CONDITION=$CONDITION
ARTIFACT_BUCKET=$ARTIFACT_BUCKET
PROJECT_DIR=$PROJECT_DIR
RUNTIME_DIR=$RUNTIME_DIR
DCV_HOSTNAME=$DCV_HOSTNAME
CLAUDE_CODE_BEDROCK_REGION=$CLAUDE_CODE_BEDROCK_REGION
CLAUDE_CODE_MODEL=$CLAUDE_CODE_MODEL
CLAUDE_CODE_SMALL_FAST_MODEL=$CLAUDE_CODE_SMALL_FAST_MODEL
EOF

cat >/usr/local/bin/genius-configure-claude-code <<'EOF'
#!/usr/bin/env bash
set -euo pipefail

participant_home="/home/participant"
project_dir="$${PROJECT_DIR:-$participant_home/GENIUS_pilot}"
bedrock_region="$${CLAUDE_CODE_BEDROCK_REGION:-$${AWS_REGION:-eu-west-2}}"
model="$${CLAUDE_CODE_MODEL:-}"
small_model="$${CLAUDE_CODE_SMALL_FAST_MODEL:-}"

install -d -o participant -g participant \
  "$participant_home/.config/Code/User" \
  "$participant_home/.config/Code/CachedExtensionVSIXs" \
  "$participant_home/.config/Code/logs" \
  "$participant_home/.claude"
chown -R participant:participant "$participant_home/.config" "$participant_home/.claude"

sudo -u participant -H code --install-extension anthropic.claude-code --force >/tmp/genius-claude-code-extension.log 2>&1 || {
  cat /tmp/genius-claude-code-extension.log >&2 || true
  exit 1
}

sudo -u participant -H bash -lc '
  set -euo pipefail
  if ! command -v claude >/dev/null 2>&1; then
    curl -fsSL https://claude.ai/install.sh | bash
  fi
' || true

python3 - "$participant_home/.claude/settings.json" "$bedrock_region" "$model" "$small_model" <<'PY'
import json
import sys
from pathlib import Path

path = Path(sys.argv[1])
region, model, small_model = sys.argv[2:5]
settings = {}
if path.exists():
    try:
        settings = json.loads(path.read_text())
    except json.JSONDecodeError:
        settings = {}
settings["$schema"] = "https://json.schemastore.org/claude-code-settings.json"
env = dict(settings.get("env", {}))
env["CLAUDE_CODE_USE_BEDROCK"] = "1"
env["AWS_REGION"] = region
env["AWS_DEFAULT_REGION"] = region
if model:
    env["ANTHROPIC_MODEL"] = model
if small_model:
    env["ANTHROPIC_SMALL_FAST_MODEL"] = small_model
settings["env"] = env
path.write_text(json.dumps(settings, indent=2) + "\n")
PY

python3 - "$participant_home/.config/Code/User/settings.json" <<'PY'
import json
import sys
from pathlib import Path

path = Path(sys.argv[1])
settings = {}
if path.exists():
    try:
        settings = json.loads(path.read_text())
    except json.JSONDecodeError:
        settings = {}
settings["claudeCode.disableLoginPrompt"] = True
settings["claudeCode.preferredLocation"] = "sidebar"
settings["security.workspace.trust.enabled"] = False
path.write_text(json.dumps(settings, indent=2) + "\n")
PY

chown -R participant:participant "$participant_home/.config/Code" "$participant_home/.claude"
EOF
chmod 0755 /usr/local/bin/genius-configure-claude-code

cat >/usr/local/bin/genius-command-audit <<'EOF'
#!/usr/bin/env bash
set -euo pipefail

. /etc/genius/session.env
exit_status="$${1:?exit status required}"
working_directory="$${2:?working directory required}"
command_text="$${3:-}"
[ -n "$command_text" ] || exit 0

log_file="$RUNTIME_DIR/terminal_commands_$${PARTICIPANT_ID}_$${SESSION_ID}.tsv"
mkdir -p "$RUNTIME_DIR"
encoded_command="$(printf '%s' "$command_text" | base64 | tr -d '\n')"
exec 9>>"$log_file"
flock 9
printf '%s\t%s\t%s\t%s\t%s\n' \
  "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$exit_status" "$$" "$working_directory" "$encoded_command" >&9
EOF
chmod 0755 /usr/local/bin/genius-command-audit

if ! grep -q '__genius_audit_previous_command' /home/participant/.bashrc; then
cat >>/home/participant/.bashrc <<'EOF'
if [[ $- == *i* ]] && command -v genius-command-audit >/dev/null; then
  __genius_audit_previous_command() {
    local exit_status=$?
    local command_text
    command_text="$(HISTTIMEFORMAT= history 1 | sed 's/^[[:space:]]*[0-9][0-9]*[[:space:]]*//')"
    [ -n "$command_text" ] && genius-command-audit "$exit_status" "$PWD" "$command_text"
  }
  PROMPT_COMMAND="__genius_audit_previous_command$${PROMPT_COMMAND:+; $PROMPT_COMMAND}"
fi
EOF
fi
chown participant:participant /home/participant/.bashrc
if ! grep -q 'HOME/.local/bin' /home/participant/.bashrc; then
cat >>/home/participant/.bashrc <<'EOF'
export PATH="$HOME/.local/bin:$HOME/.claude/local:$PATH"
EOF
fi

if ! grep -q '__genius_audit_pending_command' /home/participant/.zshrc 2>/dev/null; then
cat >>/home/participant/.zshrc <<'EOF'
export PATH="$HOME/.local/bin:$HOME/.claude/local:$PATH"
if [[ -o interactive ]] && command -v genius-command-audit >/dev/null; then
  autoload -Uz add-zsh-hook
  __genius_audit_preexec() {
    __genius_audit_pending_command="$1"
  }
  __genius_audit_precmd() {
    local exit_status=$?
    if [[ -n "$${__genius_audit_pending_command:-}" ]]; then
      genius-command-audit "$exit_status" "$PWD" "$__genius_audit_pending_command"
      unset __genius_audit_pending_command
    fi
  }
  add-zsh-hook preexec __genius_audit_preexec
  add-zsh-hook precmd __genius_audit_precmd
fi
EOF
fi
chown participant:participant /home/participant/.zshrc

if [ "$CONDITION" = "ai" ]; then
  genius-configure-claude-code || true
fi

if [ ! -d "$PROJECT_DIR/.git" ]; then
  rm -rf "$PROJECT_DIR"
  mkdir -p "$PROJECT_DIR"
  rsync -a /opt/genius/base/ "$PROJECT_DIR/"
fi

chown -R participant:participant "$PROJECT_DIR"
mkdir -p "$RUNTIME_DIR"
chown -R participant:participant "$RUNTIME_DIR"
sudo -u participant -H bash -lc "
  set -euo pipefail
  cd '$PROJECT_DIR'
  git remote set-url origin '$REPO_URL'
  git fetch --depth 1 origin '$REPO_REF'
  git checkout --detach FETCH_HEAD
  git checkout -B 'participant-$PARTICIPANT_ID'
  git config user.name 'Participant $PARTICIPANT_ID'
  git config user.email '$PARTICIPANT_ID@example.invalid'
  mkdir -p DATA_COLLECTION
  find DATA_COLLECTION -mindepth 1 -maxdepth 1 -exec rm -rf {} +
  find '$RUNTIME_DIR' -mindepth 1 -maxdepth 1 -exec rm -rf {} +
  git add -Af DATA_COLLECTION 2>/dev/null || true
  if ! git diff --cached --quiet; then
    git commit -m 'Initialize clean session data'
  fi
  START_COMMIT=\$(git rev-parse HEAD)
  git tag -f initial
  CREATED_AT=\$(date -u +%Y-%m-%dT%H:%M:%SZ)
  cat > '$RUNTIME_DIR/session_metadata_$PARTICIPANT_ID-$SESSION_ID.json' <<JSON
{
  \"participant_id\": \"$PARTICIPANT_ID\",
  \"session_id\": \"$SESSION_ID\",
  \"condition\": \"$CONDITION\",
  \"artifact_bucket\": \"$ARTIFACT_BUCKET\",
  \"start_commit\": \"\$START_COMMIT\",
  \"created_at\": \"\$CREATED_AT\"
}
JSON
"

mkdir -p /home/participant/Desktop /home/participant/.config/autostart /home/participant/dcv-storage
mkdir -p /home/participant/.config/xfce4/xfconf/xfce-perchannel-xml
cat >/home/participant/.config/mimeapps.list <<EOF
[Default Applications]
x-scheme-handler/http=google-chrome.desktop
x-scheme-handler/https=google-chrome.desktop
text/html=google-chrome.desktop
application/xhtml+xml=google-chrome.desktop
EOF
cat >/home/participant/.config/xfce4/xfconf/xfce-perchannel-xml/exo.xml <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<channel name="exo" version="1.0">
  <property name="preferred-applications" type="empty">
    <property name="WebBrowser" type="empty">
      <property name="custom" type="bool" value="true"/>
      <property name="command" type="string" value="google-chrome-stable"/>
    </property>
  </property>
</channel>
EOF

configure_group_dock() {
  local app_name app_exec app_icon app_comment app_file

  app_name="VS Code + Claude Code"
  app_exec="/usr/local/bin/open-genius-ide"
  app_icon="code"
  app_comment="Open GENIUS instructions and VS Code with Claude Code"
  app_file="genius-claude-code.desktop"

  mkdir -p /home/participant/.config/xfce4/panel/launcher-17 /home/participant/.config/xfce4/panel/launcher-18
  cat >/home/participant/.config/xfce4/panel/launcher-17/"$app_file" <<EOF
[Desktop Entry]
Version=1.0
Type=Application
Name=$app_name
Comment=$app_comment
Exec=$app_exec
Icon=$app_icon
Terminal=false
StartupNotify=true
Categories=Development;
EOF
  cat >/home/participant/.config/xfce4/panel/launcher-18/genius-chrome.desktop <<'EOF'
[Desktop Entry]
Version=1.0
Type=Application
Name=Chrome
Comment=Open Google Chrome
Exec=google-chrome-stable
Icon=google-chrome
Terminal=false
StartupNotify=true
Categories=Network;WebBrowser;
EOF
  cat >/home/participant/.config/xfce4/xfconf/xfce-perchannel-xml/xfce4-panel.xml <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<channel name="xfce4-panel" version="1.0">
  <property name="configver" type="int" value="2"/>
  <property name="panels" type="array">
    <value type="int" value="1"/>
    <value type="int" value="2"/>
    <property name="dark-mode" type="bool" value="true"/>
    <property name="panel-1" type="empty">
      <property name="position" type="string" value="p=6;x=0;y=0"/>
      <property name="length" type="uint" value="100"/>
      <property name="position-locked" type="bool" value="true"/>
      <property name="icon-size" type="uint" value="16"/>
      <property name="size" type="uint" value="26"/>
      <property name="plugin-ids" type="array">
        <value type="int" value="1"/>
        <value type="int" value="2"/>
        <value type="int" value="3"/>
        <value type="int" value="6"/>
        <value type="int" value="8"/>
        <value type="int" value="12"/>
        <value type="int" value="14"/>
      </property>
    </property>
    <property name="panel-2" type="empty">
      <property name="autohide-behavior" type="uint" value="1"/>
      <property name="position" type="string" value="p=10;x=0;y=0"/>
      <property name="length" type="uint" value="1"/>
      <property name="position-locked" type="bool" value="true"/>
      <property name="size" type="uint" value="48"/>
      <property name="plugin-ids" type="array">
        <value type="int" value="15"/>
        <value type="int" value="16"/>
        <value type="int" value="17"/>
        <value type="int" value="18"/>
      </property>
    </property>
  </property>
  <property name="plugins" type="empty">
    <property name="plugin-1" type="string" value="applicationsmenu"/>
    <property name="plugin-2" type="string" value="tasklist">
      <property name="grouping" type="uint" value="1"/>
    </property>
    <property name="plugin-3" type="string" value="separator">
      <property name="expand" type="bool" value="true"/>
      <property name="style" type="uint" value="0"/>
    </property>
    <property name="plugin-6" type="string" value="systray">
      <property name="square-icons" type="bool" value="true"/>
    </property>
    <property name="plugin-8" type="string" value="pulseaudio">
      <property name="enable-keyboard-shortcuts" type="bool" value="true"/>
      <property name="show-notifications" type="bool" value="true"/>
    </property>
    <property name="plugin-12" type="string" value="clock"/>
    <property name="plugin-14" type="string" value="actions"/>
    <property name="plugin-15" type="string" value="showdesktop"/>
    <property name="plugin-16" type="string" value="separator"/>
    <property name="plugin-17" type="string" value="launcher">
      <property name="items" type="array">
        <value type="string" value="$app_file"/>
      </property>
    </property>
    <property name="plugin-18" type="string" value="launcher">
      <property name="items" type="array">
        <value type="string" value="genius-chrome.desktop"/>
      </property>
    </property>
  </property>
</channel>
EOF
}

configure_group_dock

cat >/usr/local/bin/open-genius-ide <<'EOF'
#!/usr/bin/env bash
set -euo pipefail

PROJECT_DIR="$${PROJECT_DIR:-$HOME/GENIUS_pilot}"
INSTRUCTIONS_FILE="$PROJECT_DIR/EXPERIMENT_DOCUMENTS/PARTICIPANT_INSTRUCTIONS_AI.html"

if [ -f "$INSTRUCTIONS_FILE" ]; then
  xdg-open "$INSTRUCTIONS_FILE" >/dev/null 2>&1 &
fi

code --new-window "$PROJECT_DIR" &

for _ in $(seq 1 40); do
  if command -v wmctrl >/dev/null 2>&1 && wmctrl -r "GENIUS_pilot" -b add,maximized_vert,maximized_horz 2>/dev/null; then
    exit 0
  fi
  sleep 0.5
done
wait
EOF
chmod 0755 /usr/local/bin/open-genius-ide

cat >/home/participant/Desktop/open-genius.desktop <<EOF
[Desktop Entry]
Type=Application
Name=Open GENIUS Project
Exec=/usr/local/bin/open-genius-ide
Terminal=false
Categories=Development;
EOF
cp /home/participant/Desktop/open-genius.desktop /home/participant/.config/autostart/open-genius.desktop
chmod 0755 /home/participant/Desktop/open-genius.desktop /home/participant/.config/autostart/open-genius.desktop
chown -R participant:participant /home/participant/Desktop /home/participant/.config /home/participant/dcv-storage

sudo -u participant -H bash -lc "
  cd '$PROJECT_DIR'
  /opt/conda/bin/conda run -n genius_pilot python SCRIPTS/collect_system_info.py --participant-id '$PARTICIPANT_ID' --output '$RUNTIME_DIR/system_info.json' || true
"

cat >/home/participant/SESSION_INFO.txt <<EOF
Participant ID: $PARTICIPANT_ID
Session ID: $SESSION_ID
Condition: $CONDITION
Project: $PROJECT_DIR
Remote desktop hostname: $DCV_HOSTNAME

Use VS Code with Claude Code. Claude Code is configured for Amazon Bedrock through the VM IAM role; no per-participant browser login should be needed.
EOF
chown participant:participant /home/participant/SESSION_INFO.txt

cat >/usr/local/bin/genius-screen-recorder <<'EOF'
#!/usr/bin/env bash
set -euo pipefail

. /etc/genius/session.env

VIDEO_DIR="/home/participant/Videos"
RUNTIME_DIR="$${RUNTIME_DIR:-/home/participant/genius-runtime}"
PID_FILE="$RUNTIME_DIR/screen_recording.pid"
CURRENT_FILE="$RUNTIME_DIR/screen_recording_current_path"
LOG_FILE="$RUNTIME_DIR/screen_recording.log"
METADATA_FILE="$RUNTIME_DIR/screen_recording_$${PARTICIPANT_ID}_$${SESSION_ID}.json"
SEGMENTS_FILE="$RUNTIME_DIR/screen_recording_segments.json"
WATCHDOG_FLAG="$RUNTIME_DIR/screen_recording_watchdog.enabled"
MIN_RECORDING_WIDTH=1280
MIN_RECORDING_HEIGHT=720

validate_screen_size() {
  local size="$1"
  local width="$${size%%x*}"
  local height="$${size#*x}"
  [ "$width" -ge "$MIN_RECORDING_WIDTH" ] && [ "$height" -ge "$MIN_RECORDING_HEIGHT" ]
}

resolve_recording_context() {
  local xdcv_pid="" xdcv_args="" candidate="" display_candidates=()

  xdcv_pid="$(pgrep -u "$(id -u participant)" -f "Xdcv.*-sessionid genius" | head -n 1 || true)"
  RECORDING_XAUTHORITY=""
  if [ -n "$xdcv_pid" ] && [ -r "/proc/$xdcv_pid/cmdline" ]; then
    xdcv_args="$(tr '\0' ' ' <"/proc/$xdcv_pid/cmdline")"
    RECORDING_XAUTHORITY="$(printf '%s\n' "$xdcv_args" | awk '{for (i=1; i<=NF; i++) if ($i == "-auth") {print $(i+1); exit}}' || true)"
    if [ -r "/proc/$xdcv_pid/environ" ]; then
      candidate="$(tr '\0' '\n' <"/proc/$xdcv_pid/environ" | sed -n 's/^DISPLAY=//p' | head -n 1 || true)"
      [ -n "$candidate" ] && display_candidates+=("$candidate")
    fi
    candidate="$(printf '%s\n' "$xdcv_args" | awk '{for (i=1; i<=NF; i++) if ($i == "-display") {print $(i+1); exit}}' || true)"
    [ -n "$candidate" ] && display_candidates+=("$candidate")
  fi
  if [ -z "$RECORDING_XAUTHORITY" ]; then
    RECORDING_XAUTHORITY="/run/user/$(id -u participant)/dcv/genius.xauth"
  fi

  if [ -n "$${DISPLAY:-}" ]; then
    display_candidates+=("$${DISPLAY}")
  fi
  display_candidates+=(":1" ":2" ":3" ":4" ":5" ":0")

  RECORDING_DISPLAY=""
  RECORDING_SCREEN_SIZE=""
  local seen=""
  for candidate in "$${display_candidates[@]}"; do
    [ -z "$candidate" ] && continue
    case " $seen " in
      *" $candidate "*) continue ;;
    esac
    seen="$seen $candidate"
    candidate_size="$(DISPLAY="$candidate" XAUTHORITY="$RECORDING_XAUTHORITY" xdpyinfo 2>/dev/null | awk '/dimensions:/{print $2; exit}' || true)"
    if [ -n "$candidate_size" ] && validate_screen_size "$candidate_size"; then
      RECORDING_DISPLAY="$candidate"
      RECORDING_SCREEN_SIZE="$candidate_size"
      return 0
    fi
  done
  return 1
}

wait_for_recordable_display() {
  local max_attempts="$${1:-60}"
  local attempt=0
  while [ "$attempt" -lt "$max_attempts" ]; do
    if resolve_recording_context; then
      return 0
    fi
    attempt=$((attempt + 1))
    sleep 2
  done
  return 1
}

append_segment_metadata() {
  local output_file="$1"
  local reason="$${2:-start}"
  python3 - "$SEGMENTS_FILE" "$output_file" "$reason" "$RECORDING_DISPLAY" "$RECORDING_SCREEN_SIZE" <<'PY'
import json
import os
import sys
from datetime import datetime, timezone

segments_path, output_file, reason, display, screen_size = sys.argv[1:6]
segments = []
if os.path.exists(segments_path):
    with open(segments_path, "r", encoding="utf-8") as handle:
        segments = json.load(handle)
segments.append({
    "output_file": output_file,
    "started_at": datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"),
    "reason": reason,
    "display": display,
    "screen_size": screen_size,
    "file_exists": os.path.exists(output_file),
})
with open(segments_path, "w", encoding="utf-8") as handle:
    json.dump(segments, handle, indent=2)
    handle.write("\n")
PY
}

start_recording() {
  local resume_mode="$${1:-0}"
  mkdir -p "$VIDEO_DIR" "$RUNTIME_DIR"

  exec 9>"$RUNTIME_DIR/screen_recording.lock"
  flock -n 9 || exit 0

  if [ -s "$PID_FILE" ]; then
    local existing_pid
    existing_pid="$(cat "$PID_FILE")"
    if kill -0 "$existing_pid" 2>/dev/null; then
      exit 0
    fi
    rm -f "$PID_FILE"
  fi

  if [ "$resume_mode" = "1" ]; then
    if ! wait_for_recordable_display 90; then
      echo "Recorder resume skipped: DCV display not ready at full resolution yet." >>"$LOG_FILE"
      exit 0
    fi
  elif ! wait_for_recordable_display 30; then
    echo "Connect via DCV and open the full desktop before starting recording." >&2
    echo "Need at least $${MIN_RECORDING_WIDTH}x$${MIN_RECORDING_HEIGHT}; got default/low-res display." >&2
    exit 1
  fi

  local output_file
  output_file="$VIDEO_DIR/GENIUS_$${PARTICIPANT_ID}_$${SESSION_ID}_$(date -u +%Y%m%dT%H%M%SZ).mp4"

  DISPLAY="$RECORDING_DISPLAY" XAUTHORITY="$RECORDING_XAUTHORITY" \
    nohup ffmpeg \
      -y \
      -hide_banner \
      -loglevel info \
      -f x11grab \
      -thread_queue_size 1024 \
      -framerate 15 \
      -video_size "$RECORDING_SCREEN_SIZE" \
      -i "$RECORDING_DISPLAY" \
      -r 15 \
      -an \
      -c:v libx264 \
      -preset ultrafast \
      -crf 23 \
      -pix_fmt yuv420p \
      "$output_file" >>"$LOG_FILE" 2>&1 &

  local ffmpeg_pid=$!
  sleep 2
  if ! kill -0 "$ffmpeg_pid" 2>/dev/null; then
    echo "Screen recorder failed to start. See $LOG_FILE." >&2
    exit 1
  fi

  echo "$ffmpeg_pid" >"$PID_FILE"
  printf "%s\n" "$output_file" >"$CURRENT_FILE"
  if [ "$resume_mode" = "1" ]; then
    append_segment_metadata "$output_file" "watchdog_resume"
  else
    append_segment_metadata "$output_file" "start"
  fi

  cat >"$METADATA_FILE" <<JSON
{
  "participant_id": "$PARTICIPANT_ID",
  "session_id": "$SESSION_ID",
  "started_at": "$(date -u +%Y-%m-%dT%H:%M:%SZ)",
  "display": "$RECORDING_DISPLAY",
  "xauthority": "$RECORDING_XAUTHORITY",
  "screen_size": "$RECORDING_SCREEN_SIZE",
  "output_file": "$output_file",
  "segments_file": "$SEGMENTS_FILE"
}
JSON
}

test_recording() {
  mkdir -p "$VIDEO_DIR" "$RUNTIME_DIR"

  if ! wait_for_recordable_display 30; then
    echo "Could not find a full-resolution DCV display for recording test." >&2
    exit 1
  fi

  local test_file="$VIDEO_DIR/GENIUS_$${PARTICIPANT_ID}_$${SESSION_ID}_recording_test.mp4"
  rm -f "$test_file"

  (sleep 2; DISPLAY="$RECORDING_DISPLAY" XAUTHORITY="$RECORDING_XAUTHORITY" xterm -geometry 40x6+20+20 -T GENIUS_RECORDING_TEST -e 'for i in $(seq 1 8); do clear; echo "GENIUS recording motion test $i"; date -u; sleep 1; done' >/dev/null 2>&1 || true) &

  DISPLAY="$RECORDING_DISPLAY" XAUTHORITY="$RECORDING_XAUTHORITY" \
    ffmpeg \
      -y \
      -hide_banner \
      -loglevel warning \
      -f x11grab \
      -framerate 15 \
      -video_size "$RECORDING_SCREEN_SIZE" \
      -i "$RECORDING_DISPLAY" \
      -t 10 \
      -r 15 \
      -an \
      -c:v libx264 \
      -preset ultrafast \
      -crf 23 \
      -pix_fmt yuv420p \
      "$test_file" >"$RUNTIME_DIR/screen_recording_test.log" 2>&1

  python3 - "$test_file" "$RUNTIME_DIR/screen_recording_test.json" <<'PY'
import json
import os
import sys

path, metadata_path = sys.argv[1], sys.argv[2]
data = {
    "test_file": path,
    "file_exists": os.path.exists(path),
    "file_size_bytes": os.path.getsize(path) if os.path.exists(path) else 0,
}
with open(metadata_path, "w", encoding="utf-8") as handle:
    json.dump(data, handle, indent=2)
    handle.write("\n")
if data["file_size_bytes"] < 100000:
    raise SystemExit("Recording test file is too small; recording is likely invalid.")
PY
  rm -f "$test_file"
}

stop_recording() {
  if [ ! -s "$PID_FILE" ]; then
    local output_file=""
    if [ -s "$CURRENT_FILE" ]; then
      output_file="$(cat "$CURRENT_FILE")"
    fi
    if [ -n "$output_file" ] && [ -f "$output_file" ]; then
      python3 - "$METADATA_FILE" "$output_file" <<'PY' || true
import json
import os
import sys
from datetime import datetime, timezone

metadata_path, output_path = sys.argv[1], sys.argv[2]
try:
    with open(metadata_path, "r", encoding="utf-8") as handle:
        data = json.load(handle)
except FileNotFoundError:
    data = {}

data["stopped_at"] = datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
data["output_file"] = output_path
data["file_exists"] = bool(output_path and os.path.exists(output_path))
data["file_size_bytes"] = os.path.getsize(output_path) if data["file_exists"] else 0

with open(metadata_path, "w", encoding="utf-8") as handle:
    json.dump(data, handle, indent=2)
    handle.write("\n")
PY
    fi
    exit 0
  fi

  local pid
  pid="$(cat "$PID_FILE")"
  if kill -0 "$pid" 2>/dev/null; then
    kill -INT "$pid" 2>/dev/null || true
    for _ in $(seq 1 20); do
      if ! kill -0 "$pid" 2>/dev/null; then
        break
      fi
      sleep 1
    done
    if kill -0 "$pid" 2>/dev/null; then
      kill -TERM "$pid" 2>/dev/null || true
    fi
  fi

  local output_file=""
  if [ -s "$CURRENT_FILE" ]; then
    output_file="$(cat "$CURRENT_FILE")"
  fi

  python3 - "$METADATA_FILE" "$output_file" <<'PY' || true
import json
import os
import sys
from datetime import datetime, timezone

metadata_path, output_path = sys.argv[1], sys.argv[2]
try:
    with open(metadata_path, "r", encoding="utf-8") as handle:
        data = json.load(handle)
except FileNotFoundError:
    data = {}

data["stopped_at"] = datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
data["output_file"] = output_path
data["file_exists"] = bool(output_path and os.path.exists(output_path))
data["file_size_bytes"] = os.path.getsize(output_path) if data["file_exists"] else 0

with open(metadata_path, "w", encoding="utf-8") as handle:
    json.dump(data, handle, indent=2)
    handle.write("\n")
PY

  rm -f "$PID_FILE"
}

concat_segments() {
  python3 - "$SEGMENTS_FILE" "$VIDEO_DIR/GENIUS_$${PARTICIPANT_ID}_$${SESSION_ID}_merged.mp4" <<'PY'
import json
import os
import subprocess
import sys
import tempfile

segments_path, merged_path = sys.argv[1], sys.argv[2]
if not os.path.exists(segments_path):
    sys.exit(0)

with open(segments_path, "r", encoding="utf-8") as handle:
    segments = json.load(handle)

paths = []
for entry in segments:
    path = entry.get("output_file")
    if path and os.path.isfile(path) and os.path.getsize(path) > 0:
        paths.append(path)

if len(paths) <= 1:
    if len(paths) == 1:
        import shutil
        shutil.copy2(paths[0], merged_path)
    sys.exit(0)

with tempfile.NamedTemporaryFile("w", delete=False, suffix=".txt") as handle:
    list_path = handle.name
    for path in paths:
        handle.write(f"file '{path}'\n")

subprocess.run(
    [
        "ffmpeg", "-y", "-hide_banner", "-loglevel", "error",
        "-f", "concat", "-safe", "0", "-i", list_path,
        "-c", "copy", merged_path,
    ],
    check=False,
)
os.unlink(list_path)
PY
}

case "$${1:-}" in
  start)
    sudo /usr/local/bin/genius-watchdog-enable
    start_recording 0
    ;;
  resume)
    start_recording 1
    ;;
  stop)
    sudo /usr/local/bin/genius-watchdog-disable
    stop_recording
    concat_segments || true
    ;;
  status)
    if [ -s "$PID_FILE" ] && kill -0 "$(cat "$PID_FILE")" 2>/dev/null; then
      echo "running"
      if [ -s "$CURRENT_FILE" ]; then
        echo "file=$(cat "$CURRENT_FILE")"
      fi
      if resolve_recording_context; then
        echo "display=$RECORDING_DISPLAY size=$RECORDING_SCREEN_SIZE"
      fi
    else
      echo "stopped"
    fi
    if [ -f "$SEGMENTS_FILE" ]; then
      echo "segments=$(python3 -c "import json; print(len(json.load(open('$SEGMENTS_FILE'))))")"
    fi
    ;;
  test)
    test_recording
    ;;
  concat)
    concat_segments
    ;;
  *)
    echo "Usage: $0 {start|stop|status|test|concat|resume}" >&2
    exit 2
    ;;
esac
EOF
chmod 0755 /usr/local/bin/genius-screen-recorder

cat >/usr/local/bin/genius-recorder-watchdog <<'EOF'
#!/bin/bash
set -euo pipefail

RUNTIME_DIR="/home/participant/genius-runtime"
PID_FILE="$RUNTIME_DIR/screen_recording.pid"
WATCHDOG_FLAG="$RUNTIME_DIR/screen_recording_watchdog.enabled"
LOG_FILE="$RUNTIME_DIR/screen_recording.log"

. /etc/genius/session.env

METADATA_FILE="$RUNTIME_DIR/screen_recording_$${PARTICIPANT_ID}_$${SESSION_ID}.json"

install -d -m 0755 -o participant -g participant "$RUNTIME_DIR"
touch "$LOG_FILE"
chown participant:participant "$LOG_FILE"

current_recorded_size() {
  python3 - "$METADATA_FILE" <<'PY' 2>/dev/null || true
import json
import sys

try:
    with open(sys.argv[1], "r", encoding="utf-8") as handle:
        print(json.load(handle).get("screen_size", ""))
except OSError:
    pass
PY
}

current_display_size() {
  sudo -u participant /usr/local/bin/genius-screen-recorder status 2>/dev/null \
    | sed -n 's/.* size=\([0-9][0-9]*x[0-9][0-9]*\).*/\1/p' \
    | head -n 1
}

if [ ! -f "$WATCHDOG_FLAG" ]; then
  exit 0
fi

if [ -s "$PID_FILE" ] && kill -0 "$(cat "$PID_FILE")" 2>/dev/null; then
  recorded_size="$(current_recorded_size)"
  display_size="$(current_display_size)"
  if [ -n "$recorded_size" ] && [ -n "$display_size" ] && [ "$recorded_size" != "$display_size" ]; then
    echo "$(date -u +%Y-%m-%dT%H:%M:%SZ) watchdog: display resized from $recorded_size to $display_size; restarting recorder segment" >>"$LOG_FILE"
    sudo -u participant /usr/local/bin/genius-screen-recorder stop >>"$LOG_FILE" 2>&1 || true
    /usr/local/bin/genius-watchdog-enable >>"$LOG_FILE" 2>&1 || true
    sudo -u participant /usr/local/bin/genius-screen-recorder resume >>"$LOG_FILE" 2>&1 || true
  fi
  exit 0
fi

if [ -s "$PID_FILE" ]; then
  echo "$(date -u +%Y-%m-%dT%H:%M:%SZ) watchdog: stale recorder pid $(cat "$PID_FILE")" >>"$LOG_FILE"
  rm -f "$PID_FILE"
fi

echo "$(date -u +%Y-%m-%dT%H:%M:%SZ) watchdog: restarting screen recorder" >>"$LOG_FILE"
sudo -u participant /usr/local/bin/genius-screen-recorder resume >>"$LOG_FILE" 2>&1 || true
EOF
chmod 0755 /usr/local/bin/genius-recorder-watchdog

cat >/etc/systemd/system/genius-recorder-watchdog.service <<'EOF'
[Unit]
Description=GENIUS screen recorder watchdog

[Service]
Type=oneshot
ExecStart=/usr/local/bin/genius-recorder-watchdog
EOF

cat >/etc/systemd/system/genius-recorder-watchdog.timer <<'EOF'
[Unit]
Description=Check GENIUS screen recorder every 15 seconds

[Timer]
OnBootSec=3min
OnUnitActiveSec=15s
AccuracySec=1s

[Install]
WantedBy=timers.target
EOF

cat >/usr/local/bin/genius-watchdog-enable <<'EOF'
#!/bin/bash
set -euo pipefail
install -d -m 0755 -o participant -g participant /home/participant/genius-runtime
install -m 0644 /dev/null /home/participant/genius-runtime/screen_recording_watchdog.enabled
chown participant:participant /home/participant/genius-runtime/screen_recording_watchdog.enabled
systemctl daemon-reload
systemctl enable --now genius-recorder-watchdog.timer
EOF
chmod 0755 /usr/local/bin/genius-watchdog-enable

cat >/usr/local/bin/genius-watchdog-disable <<'EOF'
#!/bin/bash
set -euo pipefail
rm -f /home/participant/genius-runtime/screen_recording_watchdog.enabled
systemctl disable --now genius-recorder-watchdog.timer 2>/dev/null || true
EOF
chmod 0755 /usr/local/bin/genius-watchdog-disable

echo "participant ALL=(root) NOPASSWD: /usr/local/bin/genius-watchdog-enable, /usr/local/bin/genius-watchdog-disable" \
  >/etc/sudoers.d/genius-recorder
chmod 0440 /etc/sudoers.d/genius-recorder
systemctl daemon-reload
# Watchdog timer is enabled by genius-screen-recorder start, disabled by stop

cat >/usr/local/bin/genius-dcv-init <<'EOF'
#!/usr/bin/env bash
unset SESSION_MANAGER
unset DBUS_SESSION_BUS_ADDRESS
exec dbus-launch --exit-with-session startxfce4
EOF
chmod 0755 /usr/local/bin/genius-dcv-init

cat >/etc/systemd/system/genius-resource-monitor.service <<EOF
[Unit]
Description=GENIUS participant resource monitor
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=participant
WorkingDirectory=$PROJECT_DIR
ExecStart=/opt/conda/bin/conda run --no-capture-output -n genius_pilot python SCRIPTS/monitor_resources.py --output $RUNTIME_DIR/resource_usage_$${PARTICIPANT_ID}_$${SESSION_ID}.jsonl -i $MONITOR_INTERVAL
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
EOF

cat >/usr/local/bin/genius-collection-health <<'EOF'
#!/usr/bin/env bash
set -euo pipefail
. /etc/genius/session.env

mode="$${1:-show}"
mkdir -p "$RUNTIME_DIR"
resource_state="$(systemctl is-active genius-resource-monitor.service 2>/dev/null || true)"
watchdog_state="$(systemctl is-active genius-recorder-watchdog.timer 2>/dev/null || true)"
recorder_state="stopped"
recorder_pid=""
if [ -s "$RUNTIME_DIR/screen_recording.pid" ]; then
  recorder_pid="$(cat "$RUNTIME_DIR/screen_recording.pid")"
  if kill -0 "$recorder_pid" 2>/dev/null; then
    recorder_state="running"
  fi
fi
timestamp="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
output="$RUNTIME_DIR/collection_health_$${PARTICIPANT_ID}_$${SESSION_ID}.jsonl"
line="{\"timestamp\":\"$timestamp\",\"resource_monitor\":\"$resource_state\",\"recorder\":\"$recorder_state\",\"recorder_pid\":\"$recorder_pid\",\"recorder_watchdog\":\"$watchdog_state\"}"
if [ "$mode" = "snapshot" ]; then
  printf '%s\n' "$line" >>"$output"
fi
printf '%s\n' "$line"
EOF
chmod 0755 /usr/local/bin/genius-collection-health

cat >/usr/local/bin/genius-ensure-dcv-session <<'EOF'
#!/usr/bin/env bash
set -euo pipefail

. /etc/genius/session.env

update-alternatives --set x-session-manager /usr/bin/xfce4-session >/dev/null 2>&1 || true
printf "[Desktop]\nSession=xfce\n" >/home/participant/.dmrc
chown participant:participant /home/participant/.dmrc

dcv set-config --section display --key enable-client-resize "true"

systemctl enable --now dcvserver
for attempt in $(seq 1 30); do
  if systemctl is-active --quiet dcvserver; then
    break
  fi
  sleep 2
done

if dcv list-sessions | grep -q "Session: 'genius'"; then
  exit 0
fi

dcv create-session \
  --type=virtual \
  --owner participant \
  --user participant \
  --name "GENIUS $PARTICIPANT_ID" \
  --storage-root %home%/dcv-storage \
  --max-concurrent-clients 2 \
  --init /usr/local/bin/genius-dcv-init \
  genius

dcv set-display-layout --session genius 1920x1080 || true
EOF
chmod 0755 /usr/local/bin/genius-ensure-dcv-session

cat >/etc/systemd/system/genius-dcv-session.service <<EOF
[Unit]
Description=Ensure GENIUS Amazon DCV session
After=network-online.target dcvserver.service
Wants=network-online.target
Requires=dcvserver.service

[Service]
Type=oneshot
ExecStart=/usr/local/bin/genius-ensure-dcv-session
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
EOF

configure_trusted_dcv_certificate

systemctl daemon-reload
systemctl enable --now genius-resource-monitor.service

# After certificate setup on first boot, DCV can accept TCP connections while
# stalling the HTTPS handshake. Restart it before the dependent session service
# runs so the browser login page is available without manual repair.
systemctl reset-failed dcvserver || true
systemctl restart dcvserver
for attempt in $(seq 1 30); do
  if systemctl is-active --quiet dcvserver; then
    break
  fi
  sleep 2
done

systemctl enable --now genius-dcv-session.service

if [ "$AUTO_STOP_MINUTES" -gt 0 ]; then
  shutdown -h +"$AUTO_STOP_MINUTES" "GENIUS experiment auto-stop"
fi
