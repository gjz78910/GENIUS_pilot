2026-06-09 14:12:57.993 [info] [Terminal] Executing command {"terminalId":1,"command":"python -c \"\nimport time\nimport random\nfrom src.models.engineer import Engineer\nfrom src.models.job import Job\nfrom src.optimization.matching import assign_jobs\n\n# Simulate Test 1: 25 engineers, 250 jobs, 30 locations\nrandom.seed(42)\nALL_SKILLS = ['repair', 'install', 'inspect', 'configure', 'maintain', 'replace', 'upgrade', 'troubleshoot', 'calibrate', 'test']\nlocations = [f'LOC{i:05d}' for i in range(30)]\ntm = {l1: {l2: round(random.uniform(0.1, 0.5), 2) if l1 != l2 else 0.0 for l2 in locations} for l1 in locations}\n\nengineers = []\nfor i in range(1, 26):\n    skills = random.sample(ALL_SKILLS, random.randint(2, 4))\n    engineers.append(Engineer(id=i, name=f'Eng{i}', location=f'LOC{(i*10)%30:05d}', skills=skills, working_hours=8.0))\n\njobs = []\nfor i in range(1, 251):\n    length = round(random.uniform(0.5, 1.5), 1)\n    skills = random.sample(ALL_SKILLS, random.randint(1, 2))\n    jobs.append(Job(id=i, location=f'LOC{i%30:05d}', time='09:00', required_skills=skills, length=length))\n\nt0 = time.time()\nassignments, unassigned = assign_jobs(engineers, jobs, tm)\nelapsed = time.time() - t0\nprint(f'Matching: {elapsed:.3f}s')\nprint(f'Assigned: {sum(len(v) for v in assignments.values())}, Unassigned: {len(unassigned)}')\nmax_jobs = max(len(v) for v in assignments.values())\nprint(f'Max jobs per engineer: {max_jobs}')\n\" 2>&1"}
