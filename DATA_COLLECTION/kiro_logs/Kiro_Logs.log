2026-06-09 13:52:05.982 [info] [Terminal] Executing command {"terminalId":2,"command":"python -c \"\nfrom data.sample_data import engineers, jobs\nfrom data.travel_matrix import travel_matrix\nfrom src.scheduling.scheduler import Scheduler\n\nscheduler = Scheduler(list(engineers), list(jobs), travel_matrix)\nassignments, routes, unassigned = scheduler.create_schedule()\n\nprint(f'Total jobs: {len(jobs)}')\nprint(f'Assigned: {sum(len(j) for j in assignments.values())}')\nprint(f'Unassigned: {len(unassigned)}')\nfor j in unassigned:\n    print(f'  Job {j.id} at {j.location}, skills={j.required_skills}, length={j.length}h')\n    # Check which engineers could take it\n    candidates = [e for e in engineers if all(s in e.skills for s in j.required_skills)]\n    print(f'  Skilled candidates: {len(candidates)}')\n    for e in candidates:\n        assigned_jobs = assignments[e.id]\n        total_job_time = sum(jj.length for jj in assigned_jobs)\n        if e.id in routes:\n            _, travel = routes[e.id]\n        else:\n            travel = 0.0\n        remaining = e.working_hours - total_job_time - travel\n        print(f'    Eng {e.id} at {e.location}: {len(assigned_jobs)} jobs, job_time={total_job_time:.1f}h, travel={travel:.2f}h, remaining={remaining:.2f}h')\n\" 2>&1"}
