2026-06-09 14:09:50.473 [info] [Terminal] Executing command {"terminalId":5,"command":"python -c \"\nimport time\nimport random\nfrom src.models.engineer import Engineer\nfrom src.models.job import Job\nfrom src.optimization.matching import GreedyWithSwapStrategy\nfrom src.optimization.routing import find_optimal_route\n\nALL_SKILLS = ['repair', 'install', 'inspect', 'configure', 'maintain',\n    'replace', 'upgrade', 'troubleshoot', 'calibrate', 'test']\n\ndef create_travel_matrix(num_locations, seed=42):\n    rng = random.Random(seed)\n    locations = [f'LOC{i:05d}' for i in range(num_locations)]\n    return {\n        loc1: {loc2: round(rng.uniform(0.1, 0.5), 2) if loc1 != loc2 else 0.0\n               for loc2 in locations}\n        for loc1 in locations\n    }\n\ndef create_engineers(num, num_locations, seed=42):\n    rng = random.Random(seed)\n    engineers = []\n    for i in range(1, num + 1):\n        skills = rng.sample(ALL_SKILLS, rng.randint(2, 4))\n        engineers.append(Engineer(id=i, name=f'E{i}', location=f'LOC{(i*10)%num_locations:05d}', skills=skills, working_hours=8.0))\n    return engineers\n\ndef create_jobs(num, num_locations, seed=42):\n    rng = random.Random(seed)\n    jobs = []\n    for i in range(1, num + 1):\n        skills = rng.sample(ALL_SKILLS, rng.randint(1, 2))\n        jobs.append(Job(id=i, location=f'LOC{i%num_locations:05d}', time='09:00', required_skills=skills, length=round(rng.uniform(0.5, 1.5), 1)))\n    return jobs\n\ntm = create_travel_matrix(30)\nengineers = create_engineers(25, 30)\njobs = create_jobs(250, 30)\n\nstrategy = GreedyWithSwapStrategy()\nassignments, unassigned = strategy.assign(engineers, jobs, tm)\n\n# Check sizes\nfor eng in engineers:\n    assigned_jobs = assignments.get(eng.id, [])\n    if assigned_jobs:\n        locs = [j.location for j in assigned_jobs]\n        unique_locs = list(set(locs))\n        if len(locs) > 10:\n            print(f'Engineer {eng.id}: {len(locs)} job locations, {len(unique_locs)} unique')\n\n# Time one large route\neng = max(engineers, key=lambda e: len(assignments.get(e.id, [])))\nlocs = [j.location for j in assignments[eng.id]]\nprint(f'\\\\nLargest: Engineer {eng.id} with {len(locs)} locations ({len(set(locs))} unique)')\nt0 = time.time()\nroute, dist = find_optimal_route(eng.location, locs, tm)\nprint(f'Route time: {time.time()-t0:.4f}s')\n\" 2>&1","timeout":10000}
