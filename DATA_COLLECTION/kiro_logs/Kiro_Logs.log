2026-06-09 14:27:26.391 [info] [Terminal] Executing command {"terminalId":8,"command":"python -c \"\nimport time\nimport random\nfrom src.models.engineer import Engineer\nfrom src.models.job import Job\nfrom src.optimization.matching import assign_jobs\nfrom src.optimization.routing import find_optimal_route\n\n# Recreate Test 1: 25 engineers, 250 jobs, 30 locations\nALL_SKILLS = ['repair', 'install', 'inspect', 'configure', 'maintain',\n              'replace', 'upgrade', 'troubleshoot', 'calibrate', 'test']\nrng = random.Random(42)\n\n# Travel matrix\nlocations = [f'LOC{i:05d}' for i in range(30)]\ntm = {l1: {l2: round(rng.uniform(0.1, 0.5), 2) if l1 != l2 else 0.0 for l2 in locations} for l1 in locations}\n\n# Engineers\nengineers = []\nfor i in range(1, 26):\n    k = rng.randint(2, 4)\n    skills = rng.sample(ALL_SKILLS, k)\n    engineers.append(Engineer(id=i, name=f'Eng{i:04d}', location=f'LOC{(i*10)%30:05d}', skills=skills, working_hours=8.0))\n\n# Jobs\njobs = []\nfor i in range(1, 251):\n    length = round(rng.uniform(0.5, 1.5), 1)\n    k = rng.randint(1, 2)\n    required_skills = rng.sample(ALL_SKILLS, k)\n    jobs.append(Job(id=i, location=f'LOC{i%30:05d}', time='09:00', required_skills=required_skills, length=length))\n\n# Time matching\nt0 = time.time()\nassignments, unassigned = assign_jobs(engineers, jobs, tm)\nt1 = time.time()\nprint(f'Matching: {t1-t0:.3f}s')\n\n# Time routing\nt2 = time.time()\nfor eng in engineers:\n    assigned = assignments.get(eng.id, [])\n    if assigned:\n        locs = [j.location for j in assigned]\n        find_optimal_route(eng.location, locs, tm)\nt3 = time.time()\nprint(f'Routing: {t3-t2:.3f}s')\nprint(f'Total: {t3-t0:.3f}s')\n\n# Stats\njobs_per = [len(j) for j in assignments.values() if j]\nprint(f'Max jobs/engineer: {max(jobs_per) if jobs_per else 0}')\nprint(f'Avg jobs/engineer: {sum(jobs_per)/len(jobs_per):.1f}')\nprint(f'Unassigned: {len(unassigned)}')\n\" 2>&1","timeout":30000}
