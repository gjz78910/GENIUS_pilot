_route(eng.location, locs, tm)\nt_route = time.time() - t0\n\nprint(f'Matching: {t_match:.4f}s')\nprint(f'Routing:  {t_route:.4f}s')\nprint(f'Total:    {t_match + t_route:.4f}s')\n\n# Check max jobs per engineer\nmax_jobs = max(len(v) for v in assignments.values())\nprint(f'Max jobs/engineer: {max_jobs}')\n\" 2>&1","timeout":10000}
