2026-06-09 14:22:57.270 [info] [Terminal] Executing command {"terminalId":3,"command":"python -c \"\nimport time\nfrom tests.performance.test_scalability import _create_travel_matrix, _create_engineers, _create_jobs\nfrom src.optimization.matching import assign_jobs\nfrom src.optimization.routing import nearest_neighbor_tsp, two_opt_improve\n\ntm = _create_travel_matrix(30, min_travel=0.1, max_travel=0.5)\nengineers = _create_engineers(25, 30, working_hours=8.0, skill_variety='mixed')\njobs = _create_jobs(250, 30, length_range=(0.5, 1.5), skills_per_job=(1, 2))\n\nassignments, unassigned = assign_jobs(engineers, jobs, tm)\n\n# Show distribution of jobs per engineer\njob_counts = sorted([len(v) for v in assignments.values() if v], reverse=True)\nprint(f'Jobs per engineer (sorted): {job_counts}')\nprint(f'Max: {job_counts[0]}, Engineers with jobs: {len(job_counts)}')\n\n# Time routing for the heaviest engineer\nfor eng in engineers:\n    if len(assignments.get(eng.id, [])) == job_counts[0]:\n        locs = [j.location for j in assignments[eng.id]]\n        print(f'Routing {len(locs)} locations...')\n        t0 = time.time()\n        route, dist = nearest_neighbor_tsp(eng.location, locs, tm)\n        t1 = time.time()\n        print(f'  NN: {t1-t0:.4f}s')\n        route2, dist2 = two_opt_improve(route, dist, tm)\n        t2 = time.time()\n        print(f'  2-opt: {t2-t1:.4f}s')\n        break\n\" 2>&1","timeout":30000}
