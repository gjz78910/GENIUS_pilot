2026-06-09 14:02:36.281 [info] [Terminal] Executing command {"terminalId":3,"command":"python -c \"\nimport time\nimport random\nfrom src.models.engineer import Engineer\nfrom src.models.job import Job\nfrom src.optimization.matching import assign_jobs\n\n# Reproduce test 1 conditions (easiest - 25 eng, 250 jobs)\nALL_SKILLS = ['repair','install','inspect','configure','maintain','replace','upgrade','troubleshoot','calibrate','test']\nrng = random.Random(42)\nlocations = [f'LOC{i:05d}' for i in range(30)]\ntm = {l1: {l2: round(rng.uniform(0.1, 0.5), 2) if l1 != l2 else 0.0 for l2 in locations} for l1 in locations}\n\nengineers = []\nfor i in range(1, 26):\n    k = rng.randint(2, 4)\n    skills = rng.sample(ALL_SKILLS, k)\n    engineers.append(Engineer(id=i, name=f'Eng{i}', location=f'LOC{(i*10)%30:05d}', skills=skills, working_hours=8.0))\n\njobs = []\nfor i in range(1, 251):\n    length = round(rng.uniform(0.5, 1.5), 1)\n    k = rng.randint(1, 2)\n    req = rng.sample(ALL_SKILLS, k)\n    jobs.append(Job(id=i, location=f'LOC{i%30:05d}', time='09:00', required_skills=req, length=length))\n\nt0 = time.time()\nassignments, unassigned = assign_jobs(engineers, jobs, tm)\nelapsed = time.time() - t0\nprint(f'Test 1 (25 eng, 250 jobs): {elapsed:.3f}s')\nprint(f'Assigned: {sum(len(j) for j in assignments.values())}, Unassigned: {len(unassigned)}')\n\" 2>&1","timeout":10000}
