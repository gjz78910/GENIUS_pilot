2026-06-09 09:19:21.056 [info] [Terminal] Executing command {"terminalId":1,"command":"python -c \"\nimport random\nfrom src.optimization.routing import nearest_neighbor_tsp, two_opt_improve\n\nlocations = [f'L{i}' for i in range(10)]\nrng = random.Random(33)\nmatrix = {}\nfor a in locations:\n    matrix[a] = {}\n    for b in locations:\n        if a == b:\n            matrix[a][b] = 0.0\n        else:\n            matrix[a][b] = rng.uniform(1.0, 100.0)\n\nnn_route, nn_dist = nearest_neighbor_tsp('L0', locations[1:], matrix)\nprint(f'NN route distance: {nn_dist}')\nprint(f'Route length: {len(nn_route)}')\n# Test with timeout\nimport signal\ndef handler(signum, frame):\n    raise TimeoutError\nsignal.signal(signal.SIGALRM, handler)\nsignal.alarm(5)\ntry:\n    opt_route, opt_dist = two_opt_improve(nn_route, matrix)\n    print(f'2-opt distance: {opt_dist}')\n    print('SUCCESS')\nexcept TimeoutError:\n    print('TIMEOUT after 5 seconds')\n\" 2>&1","timeout":10000}
