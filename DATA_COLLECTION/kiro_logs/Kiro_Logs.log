{max_jobs}')\n\n# Now time routing for all engineers\nfrom src.optimization.routing import find_optimal_route\nt0 = time.time()\nfor eng in engineers:\n    assigned_jobs = assignments.get(eng.id, [])\n    if assigned_jobs:\n        locs = [j.location for j in assigned_jobs]\n        find_optimal_route(eng.location, locs, tm)\nt_route = time.time() - t0\nprint(f'Routing all engineers: {t_route:.4f}s')\nprint(f'Total: {elapsed + t_route:.4f}s')\n\" 2>&1","timeout":10000}
