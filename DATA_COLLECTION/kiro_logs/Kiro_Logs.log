2026-06-09 14:10:24.420 [info] [Terminal] Executing command {"terminalId":6,"command":"python -c \"\nimport time\nimport random\nimport sys\nfrom src.models.engineer import Engineer\nfrom src.models.job import Job\nfrom src.scheduling.scheduler import Scheduler\n\nALL_SKILLS = ['repair', 'install', 'inspect', 'configure', 'maintain',\n    'replace', 'upgrade', 'troubleshoot', 'calibrate', 'test']\n\ndef create_travel_matrix(num_locations, min_travel=0.2, max_travel=0.8, seed=42):\n    rng = random.Random(seed)\n    locations = [f'LOC{i:05d}' for i in range(num_locations)]\n    return {loc1: {loc2: round(rng.uniform(min_travel, max_travel), 2) if loc1 != loc2 else 0.0 for loc2 in locations} for loc1 in locations}\n\ndef create_engineers(num_engineers, num_locations, working_hours=8.0, seed=42):\n    rng = random.Random(seed)\n    engineers = []\n    for i in range(1, num_engineers + 1):\n        k = rng.randint(2, 4)\n        skills = rng.sample(ALL_SKILLS, k)\n        engineers.append(Engineer(id=i, name=f'Eng{i:04d}', location=f'LOC{(i * 10) % num_locations:05d}', skills=skills, working_hours=working_hours))\n    return engineers\n\ndef create_jobs(num_jobs, num_locations, length_range=(0.5, 3.0), skills_per_job=(1, 1), seed=42):\n    rng = random.Random(seed)\n    jobs = []\n    for i in range(1, num_jobs + 1):\n        length = round(rng.uniform(*length_range), 1)\n        k = rng.randint(*skills_per_job)\n        required_skills = rng.sample(ALL_SKILLS, k)\n        jobs.append(Job(id=i, location=f'LOC{i % num_locations:05d}', time='09:00', required_skills=required_skills, length=length))\n    return jobs\n\n# Test 1 parameters\ntm = create_travel_matrix(30, min_travel=0.1, max_travel=0.5)\nengineers = create_engineers(25, 30, working_hours=8.0)\njobs = create_jobs(250, 30, length_range=(0.5, 1.5), skills_per_job=(1, 2))\n\nscheduler = Scheduler(engineers, jobs, tm)\nt0 = time.time()\nassignments, routes, unassigned = scheduler.create_schedule()\nelapsed = time.time() - t0\nprint(f'Total time: {elapsed:.3f}s (limit: 3s)')\nprint(f'Assigned: {sum(len(v) for v in assignments.values())}, Unassigned: {len(unassigned)}')\nmax_jobs = max(len(v) for v in assignments.values()) if assignments else 0\nprint(f'Max jobs/engineer: {max_jobs}')\n\" 2>&1","timeout":60000}
